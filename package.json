{
  "name": "ai-spy",
  "version": "1.0.0",
  "description": "Real-time AI Agent Office - Mission Control Dashboard for AI agents",
  "main": "dist/main/index.js",
  "author": "Mohit Verma <mohittt.verma@gmail.com>",
  "homepage": "https://github.com/mohittt-vermaa/ai-spy",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsx watch src/main/index.ts",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "start:prod": "electron . --no-dev-server",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "capacitor:add": "cap add android",
    "capacitor:build": "cap build android",
    "capacitor:run": "cap run android",
    "build:win": "electron-builder --win --x64 --ia32",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:all": "npm run build && npm run build:win && npm run build:mac && npm run build:linux",
    "capacitor:ios": "cap add ios",
    "capacitor:build:ios": "cap build ios",
    "capacitor:build:android": "cap build android",
    "release": "gh release create v$npm_package_version dist/*.exe dist/*.dmg dist/*.AppImage dist/*.apk dist/*.ipa --title \"AI Spy v$npm_package_version\" --notes-file RELEASE_NOTES.md"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0",
    "uuid": "^9.0.0",
    "chokidar": "^3.5.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@types/yargs": "^17.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/cli": "^5.0.0",
    "@capacitor/android": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "@electron/notarize": "^2.0.0"
  },
  "build": {
    "appId": "com.aispy.app",
    "productName": "AI Spy",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "Development"
    },
    "afterSign": "build/notarize.js",
    "publish": [
      {
        "provider": "github",
        "owner": "mohittt-vermaa",
        "repo": "ai-spy"
      }
    ]
  }
}
